        "method": "POST",
        "url": "https://api.attio.com/v2/notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n(() => {\n  const md = $node[\"Extract: Brief\"].json.brief;\n  const dealId = $node[\"Webhook: Founder Call Brief\"].json.body.dealId;\n  const today = new Date().toISOString().slice(0, 10);\n\n  return {\n    data: {\n      parent_object: \"deals\",\n      parent_record_id: dealId,\n      title: \"Founder Call Brief — \" + today,\n      format: \"markdown\",\n      content: md\n    }\n  };\n})()\n}}",
        "options": {}
      },
