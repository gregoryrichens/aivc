        "jsCode": "const output = $json.output ?? $json.text ?? $json.response ?? '';\n\nif (typeof output !== 'string' || !output.trim()) {\n  throw new Error('AI Agent returned no final brief. Inspect the AI Agent execution and its tool calls.');\n}\n\nreturn [{\n  json: {\n    brief: output.trim()\n  }\n}];"
      },
